# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Node dependencies / caches
node_modules/
jspm_packages/
.npm
*.tsbuildinfo
.eslintcache
.stylelintcache
.node_repl_history
*.tgz

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Wrangler / Cloudflare
.dev.vars*
!.dev.vars.example
.env*
!.env.example
.wrangler/

# Python virtualenvs and vendored worker packages
.venv/
.venv-workers/
python_modules/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python build / dist artifacts
build/
dist/
*.egg-info/
*.egg
*.whl

# Claude Code local (per-user) settings
.claude/settings.local.json

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
